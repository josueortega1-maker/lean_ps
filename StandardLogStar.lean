import AsymptoticClosure

/-!
# The paper's iterated logarithm

The manuscript defines `logStar n` as the least number of applications of the
natural logarithm needed to obtain a value at most one.  This file formalizes
that definition literally and compares it with the inverse-exponential counter
generated by the phase proof.
-/

noncomputable section

open Filter
open scoped Topology
open Asymptotics

namespace ProbabilisticSerial.StandardLogStar

open PhaseIntegral PhaseAdapter LoadBound AsymptoticClosure

/-- Apply the natural logarithm exactly `k` times. -/
def iteratedLog : ℕ → ℝ → ℝ
  | 0, x => x
  | k + 1, x => iteratedLog k (Real.log x)

@[simp] lemma iteratedLog_zero (x : ℝ) : iteratedLog 0 x = x := rfl

@[simp] lemma iteratedLog_succ (k : ℕ) (x : ℝ) :
    iteratedLog (k + 1) x = iteratedLog k (Real.log x) := rfl

lemma exists_iteratedLog_le_one_of_le_iteratedExp :
    ∀ k : ℕ, ∀ x : ℝ, 1 ≤ x → x ≤ iteratedExp 1 k →
      ∃ j ≤ k, iteratedLog j x ≤ 1 := by
  intro k
  induction k with
  | zero =>
      intro x hxOne hxExp
      exact ⟨0, le_rfl, by simpa using hxExp⟩
  | succ k ih =>
      intro x hxOne hxExp
      by_cases hx : x ≤ 1
      · exact ⟨0, Nat.zero_le _, by simpa using hx⟩
      · have hxPos : 0 < x := zero_lt_one.trans_le hxOne
        have hlogLe : Real.log x ≤ iteratedExp 1 k := by
          apply (Real.log_le_iff_le_exp hxPos).2
          simpa using hxExp
        by_cases hlog : Real.log x ≤ 1
        · exact ⟨1, by omega, by simpa [iteratedLog] using hlog⟩
        · obtain ⟨j, hjk, hj⟩ := ih (Real.log x)
            (le_of_not_ge hlog) hlogLe
          exact ⟨j + 1, by omega, by simpa [iteratedLog] using hj⟩

lemma exists_iteratedLog_le_one (x : ℝ) :
    ∃ k : ℕ, iteratedLog k x ≤ 1 := by
  by_cases hx : x ≤ 1
  · exact ⟨0, by simpa using hx⟩
  · let k := exponentialHeight 1 x
    have hxOne : 1 ≤ x := le_of_not_ge hx
    exact (exists_iteratedLog_le_one_of_le_iteratedExp k x hxOne
      (exponentialHeight_spec 1 x)).imp (fun j hj => hj.2)

/-- The manuscript's definition: the least number of natural logarithms that
must be applied to `n` before the result is at most one. -/
def logStar (n : ℕ) : ℕ :=
  Nat.find (exists_iteratedLog_le_one (n : ℝ))

theorem iteratedLog_logStar_le_one (n : ℕ) :
    iteratedLog (logStar n) (n : ℝ) ≤ 1 :=
  Nat.find_spec (exists_iteratedLog_le_one (n : ℝ))

theorem iteratedLog_gt_one_of_lt_logStar (n k : ℕ)
    (hk : k < logStar n) :
    1 < iteratedLog k (n : ℝ) := by
  apply lt_of_not_ge
  intro hle
  have hmin : logStar n ≤ k :=
    Nat.find_min' (exists_iteratedLog_le_one (n : ℝ)) hle
  omega

/-- This pair is the exact least-integer characterization stated in the
paper, rather than an asymptotic proxy. -/
theorem logStar_least_characterization (n : ℕ) :
    iteratedLog (logStar n) (n : ℝ) ≤ 1 ∧
      ∀ k < logStar n, 1 < iteratedLog k (n : ℝ) := by
  exact ⟨iteratedLog_logStar_le_one n,
    fun k hk => iteratedLog_gt_one_of_lt_logStar n k hk⟩

lemma le_iteratedExp_of_iteratedLog_minimal :
    ∀ k : ℕ, ∀ x : ℝ,
      iteratedLog k x ≤ 1 →
      (∀ j < k, 1 < iteratedLog j x) →
      x ≤ iteratedExp 1 k := by
  intro k
  induction k with
  | zero =>
      intro x hfinal hminimal
      simpa using hfinal
  | succ k ih =>
      intro x hfinal hminimal
      have hxOne : 1 < x := by
        simpa using hminimal 0 (Nat.zero_lt_succ k)
      have hlog : Real.log x ≤ iteratedExp 1 k := by
        apply ih
        · simpa [iteratedLog] using hfinal
        · intro j hj
          simpa [iteratedLog] using hminimal (j + 1) (by omega)
      exact (Real.log_le_iff_le_exp (zero_lt_one.trans hxOne)).1 hlog

theorem cast_le_iteratedExp_logStar (n : ℕ) :
    (n : ℝ) ≤ iteratedExp 1 (logStar n) := by
  apply le_iteratedExp_of_iteratedLog_minimal
  · exact iteratedLog_logStar_le_one n
  · exact fun j hj => iteratedLog_gt_one_of_lt_logStar n j hj

lemma iteratedExp_start_mono {a b : ℝ} (hab : a ≤ b) :
    ∀ k, iteratedExp a k ≤ iteratedExp b k := by
  intro k
  induction k with
  | zero => simpa using hab
  | succ k ih => simpa using Real.exp_le_exp.mpr ih

lemma iteratedExp_one_le_shifted_phaseStart :
    ∀ k, iteratedExp 1 k ≤
      iteratedExp (alphaZero * phaseLambdaZero / 2) (k + 1) := by
  intro k
  induction k with
  | zero =>
      simp only [iteratedExp_zero, iteratedExp_succ]
      exact (by
        have hstart : 0 ≤ alphaZero * phaseLambdaZero / 2 :=
          phaseStartScale_pos.le
        simpa using Real.exp_le_exp.mpr hstart)
  | succ k ih =>
      simpa [iteratedExp_succ] using Real.exp_le_exp.mpr ih

lemma half_log_le_cast (n : ℕ) :
    Real.log (n : ℝ) / 2 ≤ (n : ℝ) := by
  by_cases hn : n = 0
  · subst n
    simp
  · have hnPos : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
    have hlog := Real.log_le_sub_one_of_pos hnPos
    have hnOne : (1 : ℝ) ≤ n := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hn
    linarith

/-- The phase counter is bounded pointwise by the paper's literal `logStar`,
up to one additional iteration caused by its fixed starting scale. -/
theorem psLogStar_le_logStar_add_one (n : ℕ) :
    psLogStar n ≤ (logStar n : ℝ) + 1 := by
  let start : ℝ := alphaZero * phaseLambdaZero / 2
  let target : ℝ := Real.log (n : ℝ) / 2
  have hreach : target ≤ iteratedExp start (logStar n + 1) := by
    calc
      target ≤ (n : ℝ) := half_log_le_cast n
      _ ≤ iteratedExp 1 (logStar n) := cast_le_iteratedExp_logStar n
      _ ≤ iteratedExp start (logStar n + 1) := by
        simpa [start] using iteratedExp_one_le_shifted_phaseStart (logStar n)
  have hnat : exponentialHeight start target ≤ logStar n + 1 :=
    Nat.find_min' (exists_iteratedExp_ge start target) hreach
  have hnatR :
      (exponentialHeight start target : ℝ) ≤ ((logStar n + 1 : ℕ) : ℝ) := by
    exact_mod_cast hnat
  simpa [psLogStar, start, target, Nat.cast_add, Nat.cast_one] using hnatR

theorem one_add_psLogStar_le_two_mul_one_add_logStar (n : ℕ) :
    1 + psLogStar n ≤ 2 * (1 + (logStar n : ℝ)) := by
  have h := psLogStar_le_logStar_add_one n
  have hnonneg : 0 ≤ (logStar n : ℝ) := Nat.cast_nonneg _
  linarith

end ProbabilisticSerial.StandardLogStar
